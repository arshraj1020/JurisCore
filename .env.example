# Copy to .env and adjust. .env is gitignored; never commit real values.
#
# Generate a JWT secret with:
#   openssl rand -base64 48

JURISCORE_JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi0xMjM0NQ==

JURISCORE_DB_URL=jdbc:postgresql://localhost:5432/juriscore
JURISCORE_DB_USER=juriscore
JURISCORE_DB_PASSWORD=juriscore

JURISCORE_REDIS_HOST=localhost
JURISCORE_REDIS_PORT=6379

# LocalStack. Leave empty to talk to real AWS.
JURISCORE_AWS_ENDPOINT=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

JURISCORE_CORS_ORIGINS=http://localhost:3000
