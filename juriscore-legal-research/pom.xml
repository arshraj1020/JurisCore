<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.juriscore</groupId>
        <artifactId>juriscore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juriscore-legal-research</artifactId>
    <name>JurisCore :: Legal Research</name>
    <description>
        Legal Precedent Intelligence: judgment ingestion, hybrid (pgvector + PostgreSQL
        full-text) retrieval, and evidence-grounded precedent analysis.
    </description>

    <dependencies>
        <!--
            One edge, to documents, for the same reason documents takes casework: a
            judgment IS a case document (uploaded through the exact same S3-presigned
            pipeline), just one this module additionally extracts, chunks and indexes.
            This module never re-implements storage or upload handling — it reacts to
            DocumentUploadCompletedEvent and reads through ObjectStorageService, both
            already exported by juriscore-common/juriscore-documents.

            juriscore-casework and juriscore-common arrive transitively, as they do for
            documents itself.
        -->
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-documents</artifactId>
        </dependency>

        <!--
            PgVectorType binds a pgvector column via the JDBC driver's own PGobject —
            deliberately not an extra pgvector-java dependency, see its javadoc. That
            needs the driver at COMPILE scope in this module specifically:
            juriscore-app depends on org.postgresql:postgresql too, but only at
            `runtime` scope (it never references a JDBC type directly, only Flyway and
            the datasource need the class at runtime), and runtime-scope dependencies
            are not exported to modules that depend on juriscore-app transitively in
            the other direction anyway — this module is compiled on its own, before
            juriscore-app exists in the reactor. No version here: it comes from the
            same spring-boot-dependencies-managed coordinate juriscore-app already
            uses, so the two can never drift apart.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!--
            Judgment text extraction.

            tika-parsers-standard-package is NOT used here. It would pull in
            tika-parser-pdf-module, which in turn pulls PDFBox 3.x. OpenHTMLtoPDF 1.0.10
            (in juriscore-billing) requires PDFBox 2.x, and Maven resolves
            org.apache.pdfbox:pdfbox to one version across the whole classpath. Having
            both 2.x and 3.x in the effective tree would mean one of the two renderers
            breaks at runtime.

            The solution is two-part:
              1. Use granular Tika 3.x parser modules that together cover every judgment
                 format the application handles (Office/ODF, plain text/RTF/CSV,
                 HTML/XHTML, images), but deliberately exclude tika-parser-pdf-module.
              2. Handle PDF extraction in LegalDocumentTextExtractor directly via the
                 PDFBox 2.x API (PDDocument + PDFTextStripper). PDFBox 2.0.31 is already
                 on the classpath for invoice rendering, so this adds zero new JARs.

            Format coverage by module:
              tika-parser-microsoft-module → DOC/DOCX, XLS/XLSX, PPT/PPTX (Apache POI)
              tika-parser-text-module      → plain text, RTF, CSV
              tika-parser-html-module      → HTML/XHTML
              tika-parser-image-module     → JPEG, PNG, TIFF and other image types
              (PDF)                        → handled in LegalDocumentTextExtractor via PDFBox

            NOTE: the artifact is tika-parser-microsoft-module, NOT tika-parser-office-module.
            tika-parser-office-module does not exist on Maven Central. The Microsoft Office
            parser has always been named tika-parser-microsoft-module in both the 2.x and 3.x
            Tika release lines.
        -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-microsoft-module</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-text-module</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-html-module</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-image-module</artifactId>
        </dependency>
        <!--
            PDFBox 2.x: used directly for PDF text extraction (see comment above).
            Version managed by root pom at 2.0.31 — no version here to avoid drift.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
