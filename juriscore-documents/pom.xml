<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.juriscore</groupId>
        <artifactId>juriscore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juriscore-documents</artifactId>
    <name>JurisCore :: Documents</name>
    <description>Case documents, stored in object storage and described in PostgreSQL.</description>

    <dependencies>
        <!--
            One edge, to casework, for the same reason case-management has one: a document
            is a document *on a matter*, so this module needs the tenant-checked case
            lookup (CaseAccess) and the append-only timeline (CaseTimelineService), and it
            takes both through those service APIs rather than through casework's
            repositories.

            Notably absent: any AWS dependency. The storage port lives in juriscore-common
            and the S3 adapter lives beside AwsConfig in juriscore-app, so nothing in this
            module imports an SDK type. That is what lets the whole document rule set be
            unit-tested with no AWS and no network.
        -->
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-casework</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
