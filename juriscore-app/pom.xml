<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.juriscore</groupId>
        <artifactId>juriscore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juriscore-app</artifactId>
    <name>JurisCore :: Application</name>
    <description>The deployable unit: composes every module, owns configuration and migrations.</description>

    <dependencies>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-organization</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-casework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-case-management</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-documents</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-notifications</artifactId>
        </dependency>
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-audit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <!-- Integration tests run against real Postgres and Redis containers. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Needed to compile DockerEnvironmentInitializer against LauncherSessionListener,
            the earliest extension point the JUnit Platform offers. Surefire and Failsafe
            already put the launcher on the runtime classpath; declaring it here is what
            makes the interface visible at compile time. Version comes from junit-bom,
            which spring-boot-dependencies imports — nothing new to keep in step.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>juriscore</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.juriscore.JurisCoreApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
