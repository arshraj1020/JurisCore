<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.juriscore</groupId>
        <artifactId>juriscore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juriscore-case-management</artifactId>
    <name>JurisCore :: Case management</name>
    <description>Courts, hearings, tasks, deadlines and reminders.</description>

    <dependencies>
        <!--
            One edge, to casework. Everything this module holds hangs off a matter:
            a hearing is a hearing in a case, a task is work on a case, a deadline is a
            date the case has to meet. So it needs two things casework owns — the
            tenant-checked case lookup (CaseAccess) and the append-only timeline
            (CaseTimelineService) — and it takes them through those service APIs rather
            than through casework's repositories, per ARCHITECTURE.md §1.

            identity, organization and common arrive transitively, exactly as they do for
            casework itself. There is no direct dependency on identity declared here even
            though IdentityFirmMemberDirectory imports UserService: adding one would state
            a boundary the reactor already gives us, and the transitive path is the same
            one casework relies on.
        -->
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-casework</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
