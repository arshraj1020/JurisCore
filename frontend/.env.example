# Base URL of the JurisCore API.
#
# Leave this unset in development: the dev server runs on http://localhost:3000, which is
# what the backend's default CORS allow-list (juriscore.security.cors.allowed-origins)
# already names, and requests go to the same origin through Vite.
#
# Set it for a deployed frontend served from a different origin than the API, e.g.
# VITE_API_BASE_URL=https://api.juriscore.example
#
# Only VITE_-prefixed variables reach the browser, and everything that does is public:
# it is compiled into the bundle. Never put a secret, key or token in this file.
VITE_API_BASE_URL=
