<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.juriscore</groupId>
        <artifactId>juriscore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>juriscore-billing</artifactId>
    <name>JurisCore :: Billing</name>
    <description>Invoices, line items and recorded payments.</description>

    <dependencies>
        <!--
            One edge, to casework, for the same reason case-management and documents each
            have one: an invoice is a bill to a *client*, usually for work on a *matter*.
            So this module needs the tenant-checked client lookup (ClientService) and the
            tenant-checked case lookup (CaseAccess), and it takes both through those
            service APIs rather than through casework's repositories.

            Notably absent: any payment SDK, and any dependency that would imply one.
            JurisCore records that money arrived and never moves any, so there is no
            gateway client, no credential store and nothing here that could hold a card
            number.
        -->
        <dependency>
            <groupId>com.juriscore</groupId>
            <artifactId>juriscore-casework</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
